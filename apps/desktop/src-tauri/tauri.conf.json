{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nai-desktop-studio",
  "version": "../../../package.json",
  "identifier": "app.mintani.nai-desktop-studio",
  "build": {
    "frontendDist": "../../web/dist/client",
    "devUrl": "http://localhost:3001"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "NovelAI image generation, kept on your own machine",
    "longDescription": "Generate images with NovelAI and keep the results, the prompts and the reference images on your own machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": {
      "resources/": ""
    }
  }
}
